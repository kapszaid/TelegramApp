# =========================================================
# NexGram - Git Ignore Rules (Security & Private Data)
# =========================================================

# ---------------------------------------------------------
# 1. CRITICAL: SENSITIVE TELEGRAM CREDENTIALS & SESSIONS
# ---------------------------------------------------------
# NEVER commit accounts.json! It contains Telegram session keys,
# active phone numbers, and login credentials.
accounts.json
*.session
*.session-journal
*.session-wal

# Environment variables & secrets
.env
.env.local
.env.development
.env.production
.env.*
!.env.example

# Telegram API credentials (use config.example.js instead)
config.js

# ---------------------------------------------------------
# 2. DEPENDENCIES
# ---------------------------------------------------------
node_modules/
.pnp
.pnp.js

# ---------------------------------------------------------
# 3. BUILD ARTIFACTS & BINARIES
# ---------------------------------------------------------
*.apk
*.aab
*.ap_
public/nexgram.apk
public/*.apk

# Android Gradle Builds & Caches
android/.gradle/
android/build/
android/app/build/
android/capacitor-cordova-android-plugins/build/
android/.idea/
android/local.properties
android/*.iml
android/app/*.iml

# Native Android Project (nexgram-native)
nexgram-native/.gradle/
nexgram-native/**/build/
nexgram-native/local.properties
nexgram-native/**/.cxx/
nexgram-native/.idea/
nexgram-native/*.iml
**/google-services.json
**/release.keystore

# Signing keys & certificates
*.jks
*.keystore
*.p12
*.pem
*.key
*.cer

# ---------------------------------------------------------
# 4. LOGS & TEMPORARY FILES
# ---------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------------------------------------------------------
# 5. OS & IDE ARTIFACTS
# ---------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
