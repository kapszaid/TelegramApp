<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_dark_secondary">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="@string/app_name"
            app:titleTextColor="@color/text_primary" />

        <!-- Independent Client Disclaimer Banner -->
        <TextView
            android:id="@+id/tvDisclaimer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#1B2836"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp"
            android:text="@string/app_disclaimer"
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />

        <!-- Account Switcher Strip -->
        <LinearLayout
            android:id="@+id/layoutAccountStrip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="8dp"
            android:gravity="center_vertical"
            android:background="@color/bg_dark_card">

            <TextView
                android:id="@+id/tvActiveAccountName"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Active Account"
                android:textColor="@color/primary"
                android:textStyle="bold"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnSwitchAccount"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="@string/btn_switch_account"
                android:textSize="12sp"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:textColor="@color/primary" />
        </LinearLayout>

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewChats"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior" />

    <!-- Floating Action Button for New Chat -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabNewChat"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        app:backgroundTint="@color/primary"
        app:tint="@color/text_primary"
        android:contentDescription="New Chat" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
