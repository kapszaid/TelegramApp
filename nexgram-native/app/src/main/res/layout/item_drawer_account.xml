<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="56dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:background="?android:attr/selectableItemBackground">

    <!-- Avatar -->
    <FrameLayout
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:layout_marginEnd="16dp">

        <ImageView
            android:id="@+id/ivAccountAvatarCircle"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:src="@drawable/circle_avatar" />

        <TextView
            android:id="@+id/tvAccountAvatarInitials"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:gravity="center"
            android:text="TG"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/ivAccountAvatarPhoto"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:scaleType="centerCrop"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Name & Phone -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvAccountName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:ellipsize="end"
            android:text="Telegram User"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvAccountPhone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:text="+1 000 000 0000"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Active Indicator Checkmark -->
    <ImageView
        android:id="@+id/ivAccountCheck"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:src="@drawable/ic_check"
        app:tint="@color/primary"
        android:visibility="gone" />

</LinearLayout>
