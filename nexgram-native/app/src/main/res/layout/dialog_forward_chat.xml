<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:maxHeight="500dp"
    android:orientation="vertical"
    android:background="@drawable/bg_bottom_sheet"
    android:paddingTop="12dp"
    android:paddingBottom="16dp">

    <!-- Top Grabber -->
    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="#3A4D60"
        android:layout_marginBottom="12dp" />

    <!-- Dialog Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/tvForwardTitle"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="Forward to..."
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/btnForwardClose"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:padding="6dp"
            android:src="@drawable/ic_close"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            app:tint="@color/text_muted" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#243444"
        android:layout_marginBottom="4dp" />

    <!-- Chats RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvForwardChats"
        android:layout_width="match_parent"
        android:layout_height="320dp"
        android:scrollbars="vertical" />

    <TextView
        android:id="@+id/tvEmptyForwardChats"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:gravity="center"
        android:text="No chats available"
        android:textColor="@color/text_muted"
        android:textSize="14sp"
        android:visibility="gone" />

</LinearLayout>
