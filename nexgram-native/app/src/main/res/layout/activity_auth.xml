<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_dark">

    <!-- Top App Bar -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbarAuth"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/bg_dark_secondary"
        app:title="@string/auth_title"
        app:titleTextColor="@color/text_primary" />

    <!-- Indeterminate Loading Indicator -->
    <ProgressBar
        android:id="@+id/progressBarAuth"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:indeterminate="true"
        android:indeterminateTint="@color/primary"
        android:visibility="gone" />

    <!-- Error Banner Card -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardAuthError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:visibility="gone"
        app:cardBackgroundColor="@color/danger_red"
        app:cardCornerRadius="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="12dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvAuthErrorMessage"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />

            <ImageView
                android:id="@+id/btnDismissError"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                android:contentDescription="Dismiss"
                app:tint="@color/text_primary" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Scrollable Flow Container -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="24dp">

            <!-- STEP 1: Phone Number Input -->
            <LinearLayout
                android:id="@+id/layoutStepPhone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="visible">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/auth_phone_title"
                    android:textColor="@color/text_primary"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/auth_phone_desc"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp"
                    android:layout_marginBottom="24dp" />

                <!-- Country Picker Spinner -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Country"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:layout_marginBottom="4dp" />

                <Spinner
                    android:id="@+id/spCountryPicker"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_auth_input"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:layout_marginBottom="16dp" />

                <!-- Country Code + Phone Number Inputs -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="24dp">

                    <EditText
                        android:id="@+id/etCountryCode"
                        android:layout_width="80dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_auth_input"
                        android:gravity="center"
                        android:hint="@string/auth_country_code_hint"
                        android:inputType="phone"
                        android:text="+1"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_muted"
                        android:textSize="16sp"
                        android:layout_marginEnd="8dp"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp" />

                    <EditText
                        android:id="@+id/etPhoneNumber"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_auth_input"
                        android:hint="@string/auth_phone_hint"
                        android:inputType="phone"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_muted"
                        android:textSize="16sp"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnPhoneContinue"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="@string/auth_btn_continue"
                    android:textColor="@color/text_primary"
                    android:backgroundTint="@color/primary"
                    style="@style/Widget.MaterialComponents.Button" />
            </LinearLayout>

            <!-- STEP 2: OTP Verification Code Input -->
            <LinearLayout
                android:id="@+id/layoutStepOtp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/auth_otp_title"
                    android:textColor="@color/text_primary"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/tvOtpSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/auth_otp_desc"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="24dp">

                    <TextView
                        android:id="@+id/tvOtpPhoneDisplay"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btnOtpWrongNumber"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/auth_otp_wrong_number"
                        android:textColor="@color/primary"
                        android:textSize="14sp"
                        android:layout_marginStart="12dp"
                        android:clickable="true"
                        android:focusable="true" />
                </LinearLayout>

                <EditText
                    android:id="@+id/etOtpCode"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_auth_input"
                    android:gravity="center"
                    android:hint="@string/auth_otp_hint"
                    android:inputType="number"
                    android:letterSpacing="0.2"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_muted"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="16dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp" />

                <Button
                    android:id="@+id/btnOtpVerify"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="@string/auth_otp_verify"
                    android:textColor="@color/text_primary"
                    android:backgroundTint="@color/primary"
                    style="@style/Widget.MaterialComponents.Button"
                    android:layout_marginBottom="12dp" />

                <Button
                    android:id="@+id/btnOtpResend"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="@string/auth_otp_resend"
                    android:textColor="@color/primary"
                    style="@style/Widget.MaterialComponents.Button.TextButton" />
            </LinearLayout>

            <!-- STEP 3: Two-Step Verification (2FA) Password Input -->
            <LinearLayout
                android:id="@+id/layoutStepPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/auth_2fa_title"
                    android:textColor="@color/text_primary"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/auth_2fa_desc"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/tvPasswordHint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/accent"
                    android:textSize="13sp"
                    android:visibility="gone"
                    android:layout_marginBottom="16dp" />

                <EditText
                    android:id="@+id/etPassword"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_auth_input"
                    android:hint="@string/auth_2fa_hint"
                    android:inputType="textPassword"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_muted"
                    android:textSize="16sp"
                    android:layout_marginBottom="24dp"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp" />

                <Button
                    android:id="@+id/btnPasswordSubmit"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="@string/auth_2fa_submit"
                    android:textColor="@color/text_primary"
                    android:backgroundTint="@color/primary"
                    style="@style/Widget.MaterialComponents.Button" />
            </LinearLayout>

            <!-- STEP 4: First & Last Name Registration (New Users) -->
            <LinearLayout
                android:id="@+id/layoutStepRegistration"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/auth_register_title"
                    android:textColor="@color/text_primary"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/auth_register_desc"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp"
                    android:layout_marginBottom="24dp" />

                <EditText
                    android:id="@+id/etFirstName"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_auth_input"
                    android:hint="@string/auth_first_name_hint"
                    android:inputType="textPersonName"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_muted"
                    android:textSize="16sp"
                    android:layout_marginBottom="16dp"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp" />

                <EditText
                    android:id="@+id/etLastName"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_auth_input"
                    android:hint="@string/auth_last_name_hint"
                    android:inputType="textPersonName"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_muted"
                    android:textSize="16sp"
                    android:layout_marginBottom="24dp"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp" />

                <Button
                    android:id="@+id/btnRegisterSubmit"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="@string/auth_register_submit"
                    android:textColor="@color/text_primary"
                    android:backgroundTint="@color/primary"
                    style="@style/Widget.MaterialComponents.Button" />
            </LinearLayout>

        </FrameLayout>
    </ScrollView>

</LinearLayout>
